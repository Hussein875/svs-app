{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,

    "strict": true,
    "esModuleInterop": true,

    "noImplicitReturns": true,
    "noUnusedLocals": true,

    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": ["src"]
}